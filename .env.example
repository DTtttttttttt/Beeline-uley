# Ключ 2ГИС из Platform Manager: MapGL JS API и Geocoder API.
# Скопировать в .env и подставить свой ключ — больше ничего заполнять не нужно.
DGIS_API_KEY=

# Ключ для карты в браузере. Если оставить пустым, compose возьмёт DGIS_API_KEY.
# Отдельное значение нужно, только если для карты выпущен свой ключ.
NUXT_PUBLIC_DGIS_KEY=

# Подсказки адресов в форме заявки (2ГИС Suggest API): сколько запросов к 2ГИС в минуту
# пропускает сервис. 0 — подсказки выключены. Лимит сверьте с Platform Manager: подсказка
# просится на каждую паузу в наборе адреса, а у демо-ключа свои лимиты.
# DGIS_SUGGEST_PER_MIN=5
# И не чаще одного запроса за столько секунд; ранний запрос ждёт своей очереди.
# DGIS_SUGGEST_INTERVAL_SEC=1

# Ассистент диспетчера (блок 42): фразу «Соколов заболел с 13:00» и вопросы к плану разбирает
# YandexGPT через Yandex AI Studio. Без ключа и каталога ассистент выключен, кнопки в шапке нет.
# Ключ API — сервисного аккаунта с ролью ai.languageModels.user; каталог — идентификатор папки
# облака. Модель — имя из карточки в консоли AI Studio (например yandexgpt/rc для 5.1 Pro) или
# полный gpt://<каталог>/<модель>. Адреса заявок при этом уходят в Yandex Cloud.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt/rc
# YANDEX_TIMEOUT_SEC=30
# Потолок ответа модели, токенов. Рассуждающие модели (gpt-oss) тратят на скрытые рассуждения тот же
# лимит — при малом значении ответ обрывается пустым. Платится то, что модель написала, а не потолок.
# Запрос с фактами плана — до ~10 тыс. токенов, вместе с ответом он должен влезать в окно модели
# (у YandexGPT Pro оно 32 тыс.).
# YANDEX_MAX_TOKENS=16000
# Сколько рассуждать рассуждающей модели (gpt-oss) при ответе на вопрос по плану: low | medium | high.
# Разбор фразы в событие не затрагивается: ему нужно думать в полную силу. Для gpt-oss ставьте low —
# без него на части вопросов модель зацикливается на рассуждении, не укладывается в потолок токенов
# за минуту с лишним и не отвечает (3 из 10 на «почему заявка назначена именно так?»). Пусто — не
# отправляется (модели без рассуждений).
# YANDEX_REASONING_EFFORT=low

# MONGO_URL, MONGO_DB, VALHALLA_URL и NUXT_PUBLIC_API_BASE здесь не задаются:
# в контейнерах их выставляет docker-compose.yml, при локальном запуске
# работают значения по умолчанию из backend/app/config.py и web/nuxt.config.ts.

# Трактовка окна заявки (PLAN 6.2): start_in_window — по ТЗ, в окно попадает начало работы;
# fit_in_window — по Дополнениям, работа целиком внутри окна. По умолчанию start_in_window.
# WINDOW_RULE=start_in_window

# Порядок критериев цели оптимизатора (PLAN 6.5): emergency_first — ни одна авария не
# уступает количеству, дальше больше заявок и меньше бригад (по умолчанию, ответ 15);
# count_first — больше заявок, затем меньше бригад, буквально по Дополнениям, п. 2;
# urgent_first — срочность и тип работ важнее экономии бригад;
# priority_first — тип работ важнее количества выполненных заявок.
# OBJECTIVE_MODE=emergency_first

# Лимит поиска OR-Tools в секундах.
# SOLVER_TIME_LIMIT_SEC=20

# Лимит поиска при перепланировании по событию: короче, потому что стартовым
# решением подаётся прошлый план.
# REPLAN_TIME_LIMIT_SEC=10

# Сколько единиц оборудования бригада уносит на день, по транспорту (PLAN 2.7, 6.2); транспорта
# нет в словаре — ограничения нет. Норматива у заказчика нет, ориентир для пешего — 1–2 единицы.
# EQUIPMENT_CAPACITY={"bicycle": 3, "public_transport": 2}

# Срок реакции на аварию, пришедшую днём, в минутах (PLAN 6.12): конец её окна — не позже
# момента поступления плюс срок. Организаторы закладывают на сетевую аварию 1–2 часа.
# EMERGENCY_RESPONSE_MIN=120

# Сколько пар «источник-цель» Valhalla берёт за один запрос таблицы переездов. Значение должно
# совпадать с max_matrix_location_pairs в valhalla/custom_files/valhalla.json: запрос сверх
# лимита отклоняется, поэтому большие наборы шлются кусками.
# VALHALLA_MAX_MATRIX_PAIRS=10000

# Прогноз опозданий (PLAN 6.18): сколько прогонов дня считать и с каким seed. Seed фиксирован,
# чтобы два расчёта одного плана давали один прогноз.
# FORECAST_RUNS=200
# FORECAST_SEED=2026

# Множители отклонений: [низ, мода, верх] — именно в таком порядке, он проверяется при старте.
# Работы растягиваются сильнее, чем ускоряются, переезды колеблются уже: пробки уже в матрицах.
# FORECAST_WORK_FACTOR=[0.8, 1.0, 1.6]
# FORECAST_TRAVEL_FACTOR=[0.9, 1.0, 1.5]
